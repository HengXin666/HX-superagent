# Copy to .env at the repo root (gitignored) before `docker compose up -d --build`.

# HX-Email checkout whose server/ and web/ are built (default: sibling checkout on the dev machine)
HX_EMAIL_DIR=../../../AI-Code/HX-Email

# Gateway admin; change both for anything but a local trial. gateway-init logs in with them.
HX_EMAIL_ADMIN_USERNAME=admin
HX_EMAIL_ADMIN_PASSWORD=admin
# Long random value, stable across restarts (encrypts stored credentials)
HX_EMAIL_SECRET_KEY=

# Ports, all on 127.0.0.1 (host networking). 8080 is avoided on purpose.
HX_EMAIL_BACKEND_PORT=18090
HX_EMAIL_HTTP_PORT=18080
SUPERAGENT_PORT=3082

# gh config dir signed in as the agent GitHub account, shared by the GitHub Source and github_user
GH_AGENT_CONFIG_DIR=./deploy/gh-agent
# uid the gateway runs as; must own GH_AGENT_CONFIG_DIR. Keep 1000 (the superagent image's node user) here;
# the bare-metal install sets the host user's uid.
APP_UID=1000
# Model key for the web template's DeepSeek provider (or put a .credentials.yaml in DSH_SEED_DIR)
DEEPSEEK_API_KEY=
# Optional: a directory holding .credentials.yaml and/or .env, copied into DSH_HOME once. Not settings.yaml.
DSH_SEED_DIR=./deploy/dsh-seed

# Optional, applied only on first start while still empty
SUPERAGENT_GITHUB_REPOSITORY=
# github_user instance id on the gateway for GitHub replies (0 = replies go out through gh directly)
HX_ROUTER_GITHUB_INSTANCE=0
